# Makefile for crypto kernel module
# Builds the enhanced driver from driver/ subdirectory

DRIVER_DIR := driver
KDIR := /lib/modules/$(shell uname -r)/build
PWD := $(shell pwd)

all:
	@echo "Building kernel modules from $(DRIVER_DIR)/ directory..."
	$(MAKE) -C $(KDIR) M=$(PWD)/$(DRIVER_DIR) modules
	@echo "Copying built modules to root directory..."
	@if [ -f $(DRIVER_DIR)/crypto_driver.ko ]; then \
		cp $(DRIVER_DIR)/crypto_driver.ko . ; \
		echo "✓ crypto_driver.ko"; \
	else \
		echo "⚠ crypto_driver.ko not found"; \
	fi
	@if [ -f $(DRIVER_DIR)/usb_kbd_monitor.ko ]; then \
		cp $(DRIVER_DIR)/usb_kbd_monitor.ko . ; \
		echo "✓ usb_kbd_monitor.ko"; \
	else \
		echo "⚠ usb_kbd_monitor.ko not found"; \
	fi
	@if [ -f crypto_driver.ko ] || [ -f usb_kbd_monitor.ko ]; then \
		echo "Module build completed successfully"; \
		ls -lh *.ko 2>/dev/null || true; \
	else \
		echo "ERROR: Module build failed - no .ko files found"; \
		exit 1; \
	fi

clean:
	$(MAKE) -C $(KDIR) M=$(PWD)/$(DRIVER_DIR) clean
	rm -f crypto_driver.ko usb_kbd_monitor.ko

install:
	@if [ ! -f crypto_driver.ko ]; then \
		echo "Module not found. Building first..."; \
		$(MAKE) all; \
	fi
	sudo insmod crypto_driver.ko
	sudo chmod 666 /dev/crypto_dev

uninstall:
	sudo rmmod crypto_driver

reload: uninstall install

.PHONY: all clean install uninstall reload
